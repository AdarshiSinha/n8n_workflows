        "jsCode": "const items = $input.all();\n\nfunction extractText(msg) {\n  // Try Slack blocks first\n  const blockText = msg.blocks\n    ?.flatMap(block => block.elements || [])\n    ?.flatMap(el => el.elements || [])\n    ?.filter(e => e.type === 'text' && typeof e.text === 'string')\n    ?.map(e => e.text)\n    ?.join('');\n\n  const text = blockText || msg.text || '';\n\n  return text\n    .replace(/<@[^>]+>/g, '') // remove mentions\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n// Extract all messages\nconst threadMessages = items.map(item => {\n  const msg = item.json;\n\n  return {\n    user: msg.user || 'unknown',\n    ts: msg.ts,\n    text: extractText(msg),\n  };\n}).filter(m => m.text);\n\n// First message = question\nconst question = threadMessages[0]?.text || '';\n\n// Combined thread text for AI summarization\nconst threadText = threadMessages\n  .map((m, i) => `Message ${i + 1}: ${m.text}`)\n  .join('\\n');\n\nconst first = items[0].json;\n\nreturn [\n  {\n    json: {\n      question,\n      threadMessages,\n      threadText,\n      channelId: first.channel,\n      thread: first.thread_ts || first.ts,\n      userId: first.user,\n      confluenceBase: 'https://vistaprint.atlassian.net',\n      spaceKey: 'PR1',\n    },\n  },\n];"

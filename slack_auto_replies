        "jsCode": "const first = $input.first().json;\n\nconst sectionEls =\n  first.blocks?.[0]?.elements?.[0]?.elements ?? [];\n\nconst combined = sectionEls\n  .filter(e => e?.type === 'text' && typeof e.text === 'string')\n  .map(e => e.text)\n  .join('');\n\nconst question = (combined || first.text || '')\n  .replace(/<@[^>]+>/g, '')\n  .trim();\n\nreturn [\n  {\n    json: {\n      question,\n      channelId: first.channel,\n      thread: first.thread_ts || first.ts,\n      userId: first.user, // <-- added only\n      confluenceBase: 'https://vistaprint.atlassian.net',\n      spaceKey: 'PR1',\n    },\n  },\n];"
